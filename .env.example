# WorkPay environment (copy to .env)
# Validated at boot by packages/shared/src/platform/env.ts. Missing critical
# secrets fail fast; optional integrations fall back to deterministic fakes.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000

# Host port the bundled PostgreSQL container binds. Change if 5432 is taken.
POSTGRES_PORT=5432

# Direct connection for migrations and the worker (long-lived).
DATABASE_URL=postgres://workpay:workpay@localhost:5432/workpay
# Pooled connection for serverless/Next in production (Supabase Supavisor).
DATABASE_URL_POOLED=postgres://workpay:workpay@localhost:5432/workpay

# Auth
AUTH_SECRET=dev-only-secret-change-me-please-32chars
AUTH_TRUST_HOST=true

# AI
# "fake" (deterministic, no network, default for CI/tests) or "openai".
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Payments
# "fake" (deterministic, no network, default for CI) or "paypal".
PAYMENT_GATEWAY=fake
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Emergency kill switch: true blocks all capture.
SYSTEM_PAYMENT_PAUSE=false

# Object storage (MinIO locally; S3/R2/Supabase Storage hosted).
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=workpay
S3_SECRET_ACCESS_KEY=workpay-secret
S3_BUCKET=workpay-artifacts
S3_FORCE_PATH_STYLE=true

# Observability
LOG_LEVEL=info
SENTRY_DSN=
