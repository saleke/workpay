# WorkPay environment (copy to .env)
# Validated at boot by packages/shared/src/platform/env.ts. Missing critical
# secrets fail fast; optional integrations fall back to deterministic fakes.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000

# Mode configuration: runs in frictionless "demo" mode by default for hackathon evaluators.
# Set WORKPAY_MODE=production and NEXT_PUBLIC_DEMO_MODE=false to run in pure SaaS mode.
WORKPAY_MODE=demo
NEXT_PUBLIC_DEMO_MODE=true

# Host port the bundled PostgreSQL container binds. Change if 5432 is taken.
POSTGRES_PORT=5432

# Direct connection for migrations and the worker (long-lived).
DATABASE_URL=postgres://workpay:workpay@localhost:5432/workpay
# Pooled connection for serverless/Next in production (Supabase Supavisor).
DATABASE_URL_POOLED=postgres://workpay:workpay@localhost:5432/workpay

# Auth
AUTH_SECRET=dev-only-secret-change-me-please-32chars
AUTH_TRUST_HOST=true

# AI Provider ("fake" for deterministic demo/CI, or "openai" for real LLMs)
AI_PROVIDER=fake
INTAKE_AI_PROVIDER=disabled
AI_GATEWAY_API_KEY=
# Set a currently available model ID from https://ai-gateway.vercel.sh/v1/models.
INTAKE_AI_MODEL=
# For direct Cloudflare Workers AI intake, set INTAKE_AI_PROVIDER=cloudflare
# in .env.development.local and provide the credentials below.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# --- FREE AI PROVIDERS (No credit card required!) ---
# Option 1: Google Gemini (Google AI Studio - 100% Free, NO credit card needed)
# Get key: https://aistudio.google.com/ -> "Get API key"
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIzaSy...
# OPENAI_MODEL=gemini-1.5-flash
#
# Option 2: Groq Cloud (Ultra-fast, 100% Free, NO credit card needed)
# Get key: https://console.groq.com/ -> "API Keys"
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Option 3: OpenRouter (Free models available, NO credit card needed)
# Get key: https://openrouter.ai/ -> "Keys"
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Payments
# "fake" (deterministic, no network, default for CI) or "paypal".
PAYMENT_GATEWAY=fake
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Emergency kill switch: true blocks all capture.
SYSTEM_PAYMENT_PAUSE=false

# Object storage (MinIO locally; S3/R2/Supabase Storage hosted).
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=workpay
S3_SECRET_ACCESS_KEY=workpay-secret
S3_BUCKET=workpay-artifacts
S3_FORCE_PATH_STYLE=true

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Transactional Email Dispatch (SMTP)
EMAIL_FROM=WorkPay <noreply@workpay.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Developer Verification (GitHub OAuth 2.0)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Authentication (OAuth 2.0 Sign-Up & Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL=nexusforsupport@gmail.com