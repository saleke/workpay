# Compose-only values
WORKPAY_DOMAIN=test.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application runtime
NODE_ENV=production
WORKPAY_MODE=production
NEXT_PUBLIC_DEMO_MODE=false
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_TRUST_HOST=true

# Keep all payment behavior simulated during product validation.
PAYMENT_GATEWAY=fake
PAYPAL_ENV=sandbox
SYSTEM_PAYMENT_PAUSE=false

# Existing planning and verification remain deterministic by default.
AI_PROVIDER=fake
INTAKE_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Cloudflare R2 (private S3-compatible bucket)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=workpay-testing
S3_FORCE_PATH_STYLE=false

# Keep the public test deployment behind a second authentication boundary.
TUNNEL_BASIC_AUTH_REQUIRED=true
TUNNEL_BASIC_AUTH_USER=workpay-tester
TUNNEL_BASIC_AUTH_PASSWORD=replace-with-a-strong-random-password

LOG_LEVEL=info
EMAIL_FROM=WorkPay <noreply@example.com>

# Optional login/email integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT_ID=
PERSONA_WEBHOOK_SECRET=
