{
  "name": "@workpay/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./platform": "./src/platform/index.ts",
    "./db": "./src/db/index.ts",
    "./events": "./src/events/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./domain": "./src/domain/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_DB_TESTS=1 vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "reset-demo": "tsx src/db/reset-demo.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "nodemailer": "^10.2.1",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
